# ArgusTrench — project environment
# Αντίγραψέ το σε .env (το .env είναι gitignored) και συμπλήρωσε τιμές.

# --- Postgres ---------------------------------------------------------------
# Dev: το container του docker-compose.yml. Το `npm run migrate` χρειάζεται ΜΟΝΟ αυτό.
DATABASE_URL=postgresql://argus:argus@localhost:5432/argus_trench_dev
# Railway: το DATABASE_URL το δίνει το Postgres plugin — μην το βάζεις χειροκίνητα.
# Αν συνδεθείς στο Railway PG από έξω (public proxy), θέλει ?sslmode=require

# --- Telegram ---------------------------------------------------------------
# Νέο bot, ξεχωριστό από το pump.fun project (BotFather).
TELEGRAM_BOT_TOKEN=
# Allowlist των chat ids που επιτρέπεται να δίνουν εντολές (comma-separated).
# ΚΕΝΟ = κανείς, όχι όλοι. Το bot username είναι ανακαλύψιμο και τα /watch /unwatch
# γράφουν στη watchlist που τροφοδοτεί τα entry signals — άρα fail closed.
# Για να βρεις το δικό σου: `npm run dev`, στείλε μήνυμα στο bot, διάβασε το rejected
# chat id από το log.
TELEGRAM_CHAT_ID=

# --- Paper / live switch ----------------------------------------------------
# Η ασφαλιστική δικλείδα του `gmgn-cli swap --yes`.
# ΜΕΝΕΙ UNSET μέχρι τη Φάση 5. Οτιδήποτε άλλο εκτός από 1 = καμία αυτόματη συναλλαγή.
# GMGN_ALLOW_AUTOMATED_TRADES=1

# --- GMGN credentials --------------------------------------------------------
# Local dev: ΔΕΝ μπαίνουν εδώ. Το gmgn-cli κρατά δικό του global config στο
# ~/.config/gmgn/.env μέσω `gmgn-cli config --apply <key>` — one-time, ανεξάρτητο
# από το project.
#
# Railway: ΠΡΕΠΕΙ να μπουν ως Railway environment variables (dashboard, όχι εδώ) —
# επιβεβαιωμένο 2026-08-26. Ένα ephemeral container δεν έχει persistent ~/.config,
# και δεν υπάρχει interactive βήμα για να τρέξει `gmgn-cli config --apply` στο
# production. Το gmgn-cli διαβάζει GMGN_API_KEY/GMGN_PRIVATE_KEY απευθείας από
# process env vars αν υπάρχουν (δοκιμασμένο με άδειο ~/.config) — και το δικό μας
# execFile περνάει αυτόματα ΟΛΟ το parent env στο child process, οπότε αρκεί να
# υπάρχουν στο Railway environment, χωρίς καμία αλλαγή κώδικα.
# Τιμές: sed -E 's/=.+/=<redacted>/' ~/.config/gmgn/.env δείχνει τα keys χωρίς να
# εκθέτει τις τιμές στο terminal history/screen share.
# GMGN_API_KEY=
# GMGN_PRIVATE_KEY=
